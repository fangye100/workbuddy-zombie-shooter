{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "WebGPU 游戏引擎 — 模块化、数据驱动、GPU-driven",
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite --config apps/samples/00-init/vite.config.ts",
    "build": "vite build --config apps/samples/00-init/vite.config.ts",
    "typecheck": "tsc -p tsconfig.check.json --pretty false",
    "smoke:nav": "tsc packages/ai/test/navigation.smoke.ts --outDir .smoke --module commonjs --target ES2022 --moduleResolution node --skipLibCheck && node .smoke/test/navigation.smoke.js",
    "editor": "vite --config apps/editor/vite.config.ts",
    "editor:build": "vite build --config apps/editor/vite.config.ts",
    "editor:smoke": "node tools/verify/editor-smoke.mjs",
    "verify:glb": "node tools/verify/cdp-verify.mjs",
    "verify:uv": "node tools/verify/uv-regularity.mjs",
    "verify:facade": "python tools/verify/facade-metric.py apps/editor/src/renderer.ts",
    "verify:prefix": "node tools/verify/guard-classprefix.mjs",
    "content:gen": "node packages/content/scripts/gen-content.mjs",
    "content:check": "node packages/content/scripts/gen-content.mjs --check",
    "bake": "node tools/baker/dist/cli.js",
    "shaderlab": "node tools/shaderlab/dist/cli.js",
    "test": "vitest run",
    "lab": "npm run editor",
    "lab:build": "npm run editor:build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-wasm": "^3.3.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "@webgpu/types": "^0.1.49"
  }
}
