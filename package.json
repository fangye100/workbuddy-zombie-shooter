{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "WebGPU 游戏引擎 — 模块化、数据驱动、GPU-driven",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config apps/samples/00-init/vite.config.ts",
    "build": "vite build --config apps/samples/00-init/vite.config.ts",
    "typecheck": "tsc -p tsconfig.check.json --pretty false",
    "smoke:nav": "tsc packages/ai/test/navigation.smoke.ts --outDir .smoke --module commonjs --target ES2022 --moduleResolution node --skipLibCheck && node .smoke/test/navigation.smoke.js",
    "editor": "vite --config apps/editor/vite.config.ts",
    "editor:build": "vite build --config apps/editor/vite.config.ts",
    "editor:smoke": "node tools/verify/editor-smoke.mjs",
    "editor:smoke:binding": "node tools/verify/editor-binding-smoke.mjs",
    "editor:smoke:all": "node tools/verify/editor-smoke.mjs && node tools/verify/editor-binding-smoke.mjs",
    "verify:glb": "node tools/verify/cdp-verify.mjs",
    "verify:uv": "node tools/verify/uv-regularity.mjs",
    "verify:facade": "python tools/verify/facade-metric.py apps/editor/src/renderer.ts",
    "verify:prefix": "node tools/verify/guard-classprefix.mjs",
    "verify:fs": "node --experimental-strip-types tools/verify/devfs-write.mjs",
    "verify:parity": "npm run runtime:build && node tools/verify/runtime-parity.mjs --scene assets/scenes/sim/floor1-t5.scene.json --seed 7 --ticks 60",
    "verify:parity-host": "node tools/verify/editor-parity.mjs",
    "content:gen": "node packages/content/scripts/gen-content.mjs && node packages/content/scripts/gen-stats.mjs",
    "content:check": "node packages/content/scripts/gen-content.mjs --check && node packages/content/scripts/gen-stats.mjs --check",
    "scene:gen": "node tools/scene/gen-asset-meta.mjs",
    "scene:check": "node tools/scene/gen-asset-meta.mjs --check && vitest run packages/scene/test/scene-files.test.ts",
    "bake": "node tools/baker/dist/cli.js",
    "shaderlab": "node tools/shaderlab/dist/cli.js",
    "runtime:build": "esbuild packages/runtime/src/index.ts --bundle --platform=node --format=cjs --outfile=.workbuddy/tmp/runtime/index.js --tsconfig=tsconfig.check.json",
    "sim": "npm run runtime:build && node tools/level/sim-level.mjs",
    "test": "vitest run",
    "mcp-binding:build": "esbuild tools/mcp-binding/src/domain-entry.ts --bundle --platform=node --format=esm --outfile=tools/mcp-binding/dist/domain.mjs --tsconfig=tsconfig.check.json",
    "mcp-binding:check": "node tools/mcp-binding/probe.mjs",
    "lab": "npm run editor",
    "lab:build": "npm run editor:build"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.49",
    "esbuild": "^0.28.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.0"
  }
}
