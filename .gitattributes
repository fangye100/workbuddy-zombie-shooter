assets/characters/models/**/*.fbx filter=lfs diff=lfs merge=lfs -text
assets/characters/models/**/*.zip filter=lfs diff=lfs merge=lfs -text
assets/characters/models/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/characters/models/**/*.obj filter=lfs diff=lfs merge=lfs -text
assets/characters/models/**/*.ply filter=lfs diff=lfs merge=lfs -text
