{
  "name": "末日尸潮 Tokens",
  "version": "1.0.0",
  "colorSpace": "sRGB",
  "note": "唯一真源。改这里后运行 _tools/gen_assets.py 重新生成 .ase / .cube。",
  "groups": {
    "core": {
      "ink": "#14110F",
      "paper": "#F5E7C8",
      "bone": "#FFF6E2",
      "night": "#171327",
      "night-deep": "#0E0C16",
      "zombie": "#8FD14F",
      "blood": "#E8402A",
      "warn": "#FFC531",
      "teal": "#2BC4D6",
      "toxic": "#9B5DE5",
      "gold": "#FF9F1C"
    },
    "rarity": {
      "rare-common": "#9AA0A6",
      "rare-rare": "#4EA8FF",
      "rare-epic": "#9B5DE5",
      "rare-legend": "#FF9F1C"
    },
    "ui": {
      "panel": "#221E33",
      "panel-deep": "#0A0812",
      "text-dim": "#9AA0A6",
      "cd-track": "#3A3550",
      "cd-icon": "#6B6880"
    }
  },
  "numbers": {
    "stroke-ink": 4,
    "stroke-bold": 6,
    "radius-card": 18,
    "radius-panel": 24,
    "shadow-hard": 6
  },
  "usage": {
    "ink": "所有描边与文字轮廓，禁止纯黑 #000",
    "paper": "UI 主底色 / 标签底 / 纸张质感",
    "bone": "高光与文字最高层级",
    "night": "HUD 面板底色，比纯黑更透气",
    "night-deep": "场景阴影端混合色（暗部色相偏移用）",
    "zombie": "敌人主色、毒系、可交互拾取高亮",
    "blood": "伤害、濒死、危险区域",
    "warn": "警告、倒计时、弹药告急",
    "teal": "科技/弹药/护盾与冷色补光",
    "toxic": "精英怪、异变、Debuff",
    "gold": "传说掉落、终极技能就绪"
  },
  "toonRamp": {
    "space": "按 NdotL 分阶，在材质着色器里做（这是生产分阶的唯一真源）",
    "stops": [
      { "name": "shadow", "ndotl": [0.0, 0.30], "multiply": 0.55, "mixTo": "night-deep", "mix": 0.30, "saturation": 1.05 },
      { "name": "lit", "ndotl": [0.30, 1.0], "multiply": 1.0, "mixTo": null, "mix": 0.0, "saturation": 1.12 },
      { "name": "spec", "ndotl": [0.88, 1.0], "multiply": 1.06, "mixTo": "bone", "mix": 0.35, "saturation": 1.0, "layer": "叠加在 lit 之上，仅金属/湿润/黏液材质" }
    ],
    "edgeSoftness": 0.035,
    "comment": "2 阶硬分阶 + 一层可选高光。暗部做色相偏移（紫蓝）而不是压灰，保住高饱和撞色。"
  },
  "grading": {
    "space": "sRGB display-referred，tonemap 之后、grading 之前（给 .cube LUT 用）",
    "purpose": "只做整体调色：加饱和、暗部染紫蓝、亮部提亮。不做分阶——分阶会误伤固有色本来就暗的材质。",
    "stops": [
      { "name": "shadow", "range": [0.0, 0.28], "multiply": 0.78, "mixTo": "night-deep", "mix": 0.20, "saturation": 1.15 },
      { "name": "mid", "range": [0.28, 0.70], "multiply": 0.98, "mixTo": null, "mix": 0.0, "saturation": 1.14 },
      { "name": "light", "range": [0.70, 1.0], "multiply": 1.04, "mixTo": "bone", "mix": 0.12, "saturation": 1.06 }
    ],
    "edgeSoftness": 0.06
  },
  "outline": {
    "method": "inverted hull（背面外扩）",
    "widthStorage": "顶点色 R 通道（0–1 映射到 0–8mm 世界空间外扩）",
    "widthsPxAt1080p": {
      "hero": 6,
      "elite": 6,
      "common-zombie": 4,
      "prop-near": 3,
      "prop-far": 2,
      "ui": 4,
      "ui-bold": 6
    },
    "notes": [
      "外扩量按摄像机距离补偿，保证屏幕空间线宽恒定",
      "cull front，depth bias 微推，避免与本体 z-fighting",
      "描边不接光照，纯 ink 色，禁止用阴影代替描边"
    ]
  }
}
